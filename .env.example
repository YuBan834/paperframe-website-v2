# Never put the real API key in frontend code or commit it to source control.
NODE_ENV=production
DEEPSEEK_API_KEY=
# The server deliberately locks Mental Link to deepseek-v4-flash.
DEEPSEEK_BASE_URL=https://api.deepseek.com
PUBLIC_BASE_URL=https://your-domain.example
# Persistent private location for issued tickets and contact messages.
DATA_DIR=/var/lib/paperframe
# Optional override; defaults to DATA_DIR/messages.txt.
# MESSAGES_FILE=/var/lib/paperframe/messages.txt
TICKET_SIGNING_SECRET=
PORT=8080
HOST=127.0.0.1
